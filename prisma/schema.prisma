generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model with HubSpot OAuth integration
model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  name                  String?
  hubspotAccessToken    String?   @map("hubspot_access_token")
  hubspotRefreshToken   String?   @map("hubspot_refresh_token")
  hubspotOwnerId        String?   @map("hubspot_owner_id")
  hubspotTokenExpiresAt DateTime? @map("hubspot_token_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  refreshTokens      RefreshToken[]
  passwordResetCodes PasswordResetCode[]
  connectionRequests ConnectionRequest[]
  connectionEvents   ConnectionRequestEvent[]
  messageActivity    MessageActivity[]
  messageEvents      MessageEvent[]
  forgottenLeadSnapshots ForgottenLeadSnapshot[]
  nextStepGapSnapshots   NextStepGapSnapshot[]
  scheduledNoTouchSnapshots ScheduledNoTouchSnapshot[]

  @@map("users")
}

// Lifecycle status of a LinkedIn connection request we sent on a user's behalf.
//
// The Sent-invitations list LinkedIn exposes to us contains ONLY outstanding
// invitations, and reports every one of them as "Pending" — resolved ones simply
// disappear. So the statuses are derived by elimination:
//   PENDING   : present in the Sent list
//   ACCEPTED  : absent, and the target is now a 1st-degree connection
//   WITHDRAWN : absent, and we intercepted the user retracting it
//   EXPIRED   : absent, and neither of the above
//
// EXPIRED therefore also absorbs declines. LinkedIn's own data model does
// distinguish REJECTED from EXPIRED, but only through the partner-gated
// /v2/invitations API; through the endpoint we can reach, a decline and an
// expiry are indistinguishable (both just vanish, with no notification).
// LinkedIn expires invitations after ~6 months, confirmed both by its help docs
// and by observation — an account with ~1 year of activity retains nothing older.
enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  // DEPRECATED: never written. Superseded by EXPIRED. Kept so existing rows
  // (if any) and historical events remain readable.
  NOT_ACCEPTED
  WITHDRAWN
  EXPIRED
}

// How we learned about a status transition — recorded on every event so a
// surprising number can be traced back to the mechanism that produced it.
enum ConnectionEventSource {
  INTERCEPT // observed the user's own action in the browser (send / withdraw)
  RECONCILE // derived by comparing our rows against a LinkedIn snapshot
  BACKFILL  // seeded from LinkedIn's Sent list for invitations predating tracking
}

// CURRENT STATE of each connection request, one row per (user, target).
//
// This table answers "what is true right now" — it is intentionally lossy:
// a re-send re-opens the same row, overwriting the previous outcome. LinkedIn
// permits re-inviting a contact once their invitation expires, so at any real
// volume that overwrite WILL happen and would silently erase expiries.
// Historical questions ("how many expired in March") must therefore be answered
// from ConnectionRequestEvent, which is append-only. Snapshot questions
// ("how many are pending right now") are answered from here.
model ConnectionRequest {
  id               String                  @id @default(uuid())
  userId           String                  @map("user_id")
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Target (B'): the LinkedIn profile the request was sent TO.
  targetLinkedinId String                  @map("target_linkedin_id")
  targetProfileUrl String?                 @map("target_profile_url")
  targetName       String?                 @map("target_name")
  // Actor (B): the LinkedIn account logged into the browser that SENT the
  // request. Distinct from userId (A), the extension/app account — one app user
  // may operate several LinkedIn accounts, so the actor is stored per row.
  actorLinkedinId        String?           @map("actor_linkedin_id")
  actorName              String?           @map("actor_name")
  actorPublicIdentifier  String?           @map("actor_public_identifier")
  status           ConnectionRequestStatus @default(PENDING)
  sentAt           DateTime                @default(now()) @map("sent_at")
  // True when sentAt was inferred from LinkedIn's relative "Sent 3 weeks ago"
  // text during backfill rather than observed at send time. Such dates are
  // accurate only to the granularity LinkedIn renders (days → weeks → months).
  sentAtIsEstimate Boolean                 @default(false) @map("sent_at_is_estimate")
  resolvedAt       DateTime?               @map("resolved_at")
  // First COMPLETE sent-list walk in which this row was pending but absent from
  // LinkedIn's list. Offset pagination over a list that mutates mid-walk can
  // skip an entry, and a skipped entry is indistinguishable from a resolved one
  // — so absence must be confirmed by a second consecutive complete walk before
  // we write a terminal status. Cleared if the invitation reappears.
  absentSince      DateTime?               @map("absent_since")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@unique([userId, targetLinkedinId])
  @@index([userId])
  @@index([status])
  @@index([sentAt])
  @@index([userId, sentAt])
  @@index([actorLinkedinId])
  @@index([userId, status])
  @@index([userId, actorLinkedinId, status])
  @@map("connection_requests")
}

// APPEND-ONLY history of connection-request status transitions.
//
// Never updated or deleted. One row per transition, including the initial send
// and every re-send. This is what makes historical counts survive the
// re-send-overwrites-the-row behaviour of ConnectionRequest above.
model ConnectionRequestEvent {
  id               String                   @id @default(uuid())
  userId           String                   @map("user_id")
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetLinkedinId String                   @map("target_linkedin_id")
  // Snapshotted so a report row stays readable even if the current-state row is
  // later re-opened and its target details change.
  targetName       String?                  @map("target_name")
  targetProfileUrl String?                  @map("target_profile_url")
  actorLinkedinId  String?                  @map("actor_linkedin_id")
  // Snapshotted for the same reason as targetName/targetProfileUrl above — the
  // Connection Requests report table now reads directly from this event log
  // (one row per transition, dated by occurredAt) rather than the current-state
  // table, so it needs the actor's display identity available per-row.
  actorName             String?             @map("actor_name")
  actorPublicIdentifier String?             @map("actor_public_identifier")
  // null for the initial send (no prior state).
  fromStatus       ConnectionRequestStatus? @map("from_status")
  toStatus         ConnectionRequestStatus  @map("to_status")
  // When the transition actually happened. Distinct from detectedAt because a
  // periodic sync notices things long after they occur — bucketing a chart on
  // detection time would show sync cadence rather than real activity.
  occurredAt       DateTime                 @map("occurred_at")
  // True when occurredAt is inferred rather than observed. Expiries are always
  // estimated (LinkedIn never tells us the moment); sends and withdrawals are
  // observed exactly; acceptances use LinkedIn's real connection date.
  occurredAtIsEstimate Boolean              @default(false) @map("occurred_at_is_estimate")
  detectedAt       DateTime                 @default(now()) @map("detected_at")
  source           ConnectionEventSource
  createdAt        DateTime                 @default(now()) @map("created_at")

  @@index([userId, occurredAt])
  @@index([actorLinkedinId, occurredAt])
  @@index([toStatus, occurredAt])
  @@index([userId, toStatus, occurredAt])
  @@index([userId, targetLinkedinId])
  @@map("connection_request_events")
}

// Per-user messaging metrics, one row per conversation. Derived from LinkedIn's
// messenger data: sent/received counts, follow-ups (re-pings with no reply),
// read (seen) count, whether the other party replied, and whether it became a
// real conversation (>2 messages, both sides). Unique per (user, conversation)
// so re-syncing a thread updates its row.
model MessageActivity {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationKey       String    @map("conversation_key")
  // The other party (receiver).
  participantLinkedinId String?   @map("participant_linkedin_id")
  participantName       String?   @map("participant_name")
  participantProfileUrl String?   @map("participant_profile_url")
  // The app user's own LinkedIn identity (sender) for this conversation.
  selfLinkedinId        String?   @map("self_linkedin_id")
  selfName              String?   @map("self_name")
  selfProfileUrl        String?   @map("self_profile_url")
  sentCount             Int       @default(0) @map("sent_count")
  receivedCount         Int       @default(0) @map("received_count")
  followUpCount         Int       @default(0) @map("follow_up_count")
  readCount             Int       @default(0) @map("read_count")
  hasReply              Boolean   @default(false) @map("has_reply")
  isConversation        Boolean   @default(false) @map("is_conversation")
  firstMessageAt        DateTime? @map("first_message_at")
  lastMessageAt         DateTime? @map("last_message_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([userId, conversationKey])
  @@index([userId])
  @@index([lastMessageAt])
  @@index([userId, lastMessageAt])
  @@index([selfLinkedinId])
  @@map("message_activity")
}

enum MessageEventType {
  SENT
  RECEIVED
}

// Per-message history, one row per (user, conversation, message).
//
// WHY THIS EXISTS: MessageActivity above holds one row per conversation with
// LIFETIME aggregate counts, keyed to the conversation's lastMessageAt. A
// conversation can span months, so bucketing a chart by lastMessageAt dumps a
// conversation's entire history onto whichever single day its most recent
// message happened to land on — the same class of bug ConnectionRequestEvent
// was built to fix for connection requests. This table stores each message as
// its own event, at its own occurredAt, so a day/week/month series reflects
// when activity actually happened.
//
// occurredAt and type are immutable facts and never change once written. The
// classification fields (isFirstTouch, isFollowUp, isFirstReply, respondsToAt)
// are NOT insert-only: the extension derives them from whatever conversation
// history is currently loaded, and LinkedIn paginates — a long thread's full
// history isn't loaded on first open. An early derivation can genuinely be
// wrong about a boundary message (verified live: a message looked like a
// conversation's "first touch" until older history loaded and revealed it
// was really a follow-up). messageEventService.recordEvents UPSERTS the
// classification fields using a merge rule proven safe in both directions
// (a more- or a less-informed later call) — see that file for the full
// reasoning per field.
model MessageEvent {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationKey String           @map("conversation_key")
  // Stable per-message id derived on the client: `${deliveredAt}:${senderId}`.
  messageId       String           @map("message_id")
  type            MessageEventType
  occurredAt      DateTime         @map("occurred_at") // the message's own deliveredAt
  // SENT only: this is the very first message WE ever sent in this
  // conversation — the "fresh (first-touch)" metric the report wants. Exactly
  // one true per conversation.
  isFirstTouch    Boolean          @default(false) @map("is_first_touch")
  // SENT only: immediately followed our own prior send with no reply from the
  // other party in between (a re-ping).
  isFollowUp      Boolean          @default(false) @map("is_follow_up")
  // RECEIVED only: the first message the OTHER party ever sent in this
  // conversation, and only after we had already sent something — i.e. the
  // moment a first-touch got its reply.
  isFirstReply    Boolean          @default(false) @map("is_first_reply")
  // The immediately preceding message in this conversation (either side),
  // i.e. what THIS message is a response to. Null for the very first message.
  // Used by the Late Messages / Missed Follow-Up reports to measure how long
  // a SENT message took to answer whatever came before it.
  respondsToAt    DateTime?        @map("responds_to_at")
  // The rep's IANA timezone at the moment this message was recorded (e.g.
  // "Asia/Kolkata"), read from the browser (same source as the existing
  // userTimeZone pattern used for HubSpot task due-dates — never stored
  // per-user server-side). Lateness quiet-hours are evaluated in this zone.
  selfTimeZone    String?          @map("self_time_zone")
  participantLinkedinId String?    @map("participant_linkedin_id")
  selfLinkedinId  String?          @map("self_linkedin_id")
  // The message's own text, captured so the Messages report can show an
  // in-app conversation popup instead of deep-linking to LinkedIn's own
  // chat page (which fails whenever the viewer isn't logged into the exact
  // LinkedIn account that sent/received it). Only populated going forward —
  // existing rows predate this column and will read as null. Immutable like
  // occurredAt/type, but COALESCEd (not excluded) on conflict: unlike the
  // classification flags, there's no reason a later, more-informed
  // derivation would ever see a WORSE value than an earlier one that missed
  // it (e.g. a transient DOM read), so filling a null is always safe.
  text            String?
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([userId, conversationKey, messageId])
  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@index([userId, type, occurredAt])
  // Powers the Missed Follow-Up report's "last event per conversation" query
  // (DISTINCT ON (user_id, conversation_key) ... ORDER BY occurred_at DESC).
  @@index([userId, conversationKey, occurredAt])
  // Powers the resolved-late deadline-crossing query, filtered by respondsToAt
  // (not occurredAt — a resolution can be arbitrarily far after its trigger,
  // so bounding by occurredAt wouldn't let a chart's date range bound the
  // scan). isFollowUp=true already implies type=SENT (only sent messages get
  // this flag), so type isn't needed in the index.
  @@index([userId, isFollowUp, respondsToAt])
  @@map("message_events")
}

// Daily snapshot of "forgotten active leads" — active HubSpot contacts (not
// Not Interested / not DND-Suspended) with no task or activity EVER recorded
// (both Next Activity Date and Last Activity Date unknown). HubSpot Contact
// state is never mirrored locally elsewhere in this codebase (see
// hubspotContactService.ts — contacts are always fetched live), so unlike
// ConnectionRequestEvent/MessageEvent this is NOT an append-only fact log —
// it is a snapshot of a live HubSpot query result, taken at most once per
// (user, UTC calendar day). Written lazily: the first /api/public/summary
// request of the day for a given owner computes and stores it; every later
// request that day reads the stored row instead of re-querying HubSpot. This
// is what stands in for a cron job on a free-tier Vercel deployment that
// cannot schedule sub-daily (or, depending on plan, any) cron runs.
//
// NOT additive across days like MessageEvent/ConnectionRequestEvent — a
// backlog count is a gauge, not an event count. See ForgottenLeadService for
// how this is reflected in getSeries (last-value-per-bucket, never summed
// across days) and getTotals (latest row only).
model ForgottenLeadSnapshot {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Truncated to UTC midnight — the calendar day this snapshot represents,
  // not the instant it was computed (see createdAt for that).
  snapshotDate DateTime @map("snapshot_date")
  count        Int
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, snapshotDate])
  @@index([snapshotDate])
  @@map("forgotten_lead_snapshots")
}

// Daily snapshot of "No Next Step Scheduled" — active HubSpot contacts (same
// active-status exclusion as ForgottenLeadSnapshot above) with Next Activity
// Date unknown, split into two segments:
//   touchedCount     : Last Activity Date IS known — someone engaged once and
//                       then never scheduled a follow-up (the higher-priority
//                       "dropped ball" segment).
//   neverTouchedCount: Last Activity Date is ALSO unknown — nobody has ever
//                       touched this lead at all (cold, lower priority).
// Same lazy-snapshot mechanism as ForgottenLeadSnapshot (see that model's
// comment for the full reasoning — no cron on Vercel's free tier, so the
// first /api/public/summary request of the UTC day per owner computes +
// stores this, every later request that day reads the stored row) and the
// same GAUGE semantics (see NextStepGapService/NextStepGapRepository for how
// getSeries/getTotals reflect that — never summed across days).
model NextStepGapSnapshot {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotDate  DateTime @map("snapshot_date")
  touchedCount  Int      @map("touched_count")
  neverTouchedCount Int  @map("never_touched_count")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([userId, snapshotDate])
  @@index([snapshotDate])
  @@map("next_step_gap_snapshots")
}

// Daily snapshot of "Scheduled, Never Touched" — active HubSpot contacts
// (same active-status exclusion as the other 2 HubSpot-state graphs) where
// Last Activity Date is unknown BUT Next Activity Date IS known — someone
// scheduled a task/meeting for a contact they've never actually engaged.
// The mirror-image quadrant of ForgottenLeadSnapshot (which requires BOTH
// dates unknown) and NextStepGapSnapshot's "neverTouched" segment (same) —
// this is the one quadrant neither of those graphs covers. Single count, no
// segmentation (unlike NextStepGapSnapshot) — see NextStepGapService for the
// GAUGE-not-event-count reasoning this also follows.
model ScheduledNoTouchSnapshot {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotDate DateTime @map("snapshot_date")
  count        Int
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, snapshotDate])
  @@index([snapshotDate])
  @@map("scheduled_no_touch_snapshots")
}

// Hashed, rotating refresh tokens for user sessions (7-day TTL).
// Only the SHA-256 hash of the opaque token is stored, so a DB leak
// exposes no usable tokens. Rotation + reuse detection guard against theft.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
  @@index([userId])
  @@index([expiresAt])
}

// Short-lived, single-use 6-digit password-reset codes (OTP).
// Stored as a SHA-256 hash, attempt-limited, and tied to a user.
model PasswordResetCode {
  id        String    @id @default(uuid())
  codeHash  String    @map("code_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_codes")
  @@index([userId])
}

// OAuth state for secure authorization flow (CSRF protection)
model OAuthState {
  id        String   @id @default(uuid())
  state     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("oauth_states")
  @@index([state])
  @@index([expiresAt])
}
