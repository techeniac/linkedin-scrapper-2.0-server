PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
JWT_SECRET=
# Fallback only; access tokens use ACCESS_TOKEN_TTL
JWT_EXPIRES_IN=7d

# Session tokens: short-lived access JWT + long-lived rotating refresh token
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Window after a refresh token is rotated during which reusing it is treated as
# a benign multi-tab/multi-context race rather than theft (see tokenService.ts).
REFRESH_REUSE_GRACE_MS=10000

# Password-reset OTP (6-digit code emailed to the user)
RESET_CODE_TTL_MINUTES=10
RESET_CODE_MAX_ATTEMPTS=5

# SMTP for transactional email (password-reset codes). Leave empty to disable
# sending; in non-production the code is logged instead so the flow is testable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HubLead <no-reply@example.com>

# Rate limiting - window in minutes, max requests per window for the global IP limiter
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Shared store for rate limiting across serverless instances (Upstash Redis or any Redis).
# Leave empty to use an in-memory store (per-instance only; fine for local dev).
# Example: rediss://default:<token>@<host>:<port>
REDIS_URL=

# Optional shared secret for the unauthenticated /api/public/* reporting
# endpoints. Leave EMPTY to keep them open (current behaviour). When set,
# requests must send `x-api-key: <key>` or `Authorization: Bearer <key>`.
PUBLIC_API_KEY=

# Connection Requests report — how many months a sent invitation survives in
# LinkedIn's Sent list before it's treated as expired. LinkedIn documents ~6
# months; confirmed independently by observation (see connectionEventService.ts).
LINKEDIN_INVITE_EXPIRY_MONTHS=6

LOG_LEVEL=info

# CORS - comma-separated list
ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://YOUR_EXTENSION_ID

# Late Messages report — deadline for flagging a REPLY (to the other party's
# message) as late. Quiet hours are evaluated in the sending rep's own local
# time (browser-sourced). A message arriving during quiet hours gives the
# rep the rest of that calendar day to reply; outside quiet hours it's a
# flat THRESHOLD_HOURS from when the message arrived, no other adjustment.
LATE_MSG_THRESHOLD_HOURS=3
LATE_MSG_QUIET_START_HOUR=0
LATE_MSG_QUIET_END_HOUR=7

# Late/Missed Follow-Up — deadline for the NEXT follow-up after our own send
# with no reply. Flat days, no quiet-hours adjustment. Used by both the Late
# Messages report's LATE_FOLLOW_UP category and the Missed Follow-Up report.
LATE_FOLLOWUP_THRESHOLD_DAYS=7

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/hubspot/callback
HUBSPOT_SCOPES=crm.objects.contacts.write crm.objects.contacts.read crm.objects.companies.write crm.objects.companies.read crm.objects.owners.read
